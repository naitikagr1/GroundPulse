# ---- required: without this the forms refuse to submit ----------------------
# Any Postgres will do — Neon, Supabase, Vercel Postgres, your own.
# Use the POOLED connection string on serverless.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ---- optional: email alert on every new lead --------------------------------
# Without these the lead is still saved; you just are not pinged about it.
# Always set these two:
LEADS_EMAIL_TO="hello@stillyours.in"
LEADS_EMAIL_FROM="StillYours <hello@stillyours.in>"

# then pick ONE way to send.

# (a) Resend — no SMTP, no app password. Takes priority if set.
RESEND_API_KEY=""

# (b) Any SMTP server, including your own Gmail. For Gmail:
#     SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com,
#     SMTP_PASS=<16-character Google App Password, NOT your normal password>
#     and set LEADS_EMAIL_FROM to that same Gmail address.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""

# ---- optional: the map and address search (Ola Maps) ------------------------
# Without these, a local dev server draws OpenStreetMap tiles and hides the
# address search; production shows no map. Pins, "I am at the property" and
# the check-in rules work either way. Keys: cloud.olakrutrim.com → Maps.
# Lock every key to your domains (and localhost) in the Ola console.
OLA_MAPS_API_KEY=""
# Preferred for the server's own calls (search, reverse geocode) when set:
OLA_MAPS_CLIENT_ID=""
OLA_MAPS_CLIENT_SECRET=""
# A separate, domain-locked key just for drawing the map in the browser.
# Falls back to OLA_MAPS_API_KEY.
OLA_MAPS_BROWSER_KEY=""

# ---- required in production: video storage (Cloudflare R2) ------------------
# Room walkthroughs and issue / repair clips. Without these, a local dev server
# keeps clips in .data/media; production refuses to record.
# Bucket: private. CORS on the bucket must allow PUT from the app's origins
# with the content-type header (see the launch runbook).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# ---- required in production: the sign-in secret ------------------------------
# Signs the login cookie and the pending sign-in code. Generate once with
#   openssl rand -base64 48
# and never change it — changing it signs everybody out.
# (SESSION_SECRET is still read if SESSION_SECRET1 is absent.)
SESSION_SECRET1=""

# ---- required in production: payments (Razorpay) ---------------------------
# 25% at booking, 75% when the report is ready, repairs when approved.
# Without keys a local dev server simulates payments; production refuses.
# Webhook: Razorpay dashboard → Webhooks → https://<domain>/api/razorpay/webhook
# with events payment.captured and order.paid, and the secret below.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ---- required in production: sign-in codes by SMS (MSG91, or Fast2SMS) -----
# Inspector sign-in codes; Indian mobiles only. Without one of these,
# production cannot send codes and no inspector can sign in. A laptop never
# sends a real SMS unless SMS_IN_DEV=1 — the code is shown on screen instead.
# MSG91 → OTP → Widget: mobile, SMS, 6 digits, Mobile Integration on, captcha
# off, the default template (no DLT needed). Widget ID from the widget; the
# token from Tokens in the sidebar. Used first when both are set.
MSG91_WIDGET_ID=""
MSG91_TOKEN_AUTH=""
# Fast2SMS's OTP route — only once the website and an Aadhaar are verified.
FAST2SMS_API_KEY=""
SMS_IN_DEV=""

# ---- required in production: owner sign-in with Google ----------------------
# Google Cloud → APIs & Services → Credentials → OAuth client ID (Web app).
# Authorised redirect URIs:
#   https://stillyours.in/api/auth/google/callback
#   https://www.stillyours.in/api/auth/google/callback
#   http://localhost:61132/api/auth/google/callback
# Without these, a laptop offers a development sign-in by email instead;
# production says Google sign-in is not switched on yet.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- required in production: the ops console --------------------------------
# /ops is one page behind this password — no account. Set it in Vercel, never
# in this file. Without it the console cannot be opened at all.
OPS_PASSWORD=""
